{
  "name": "offersplus-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Frontend application for Offers+, a modern job application tracking system",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run generate-sitemap",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "generate-sitemap": "tsx src/utils/generateSitemap.ts",
    "generate:api-types": "openapi-typescript ../backend/openapi.yaml -o src/types/api.ts",
    "cypress": "cypress open",
    "cypress:headless": "cypress run",
    "upload:applications": "tsx scripts/uploadApplications.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.110.9",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.19.0",
    "globby": "^16.2.2",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "react-toastify": "^11.0.5",
    "redis": "^6.2.0",
    "sql.js": "^1.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/cypress": "^10.0.3",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.18",
    "csv-parse": "^7.0.1",
    "cypress": "^15.19.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "happy-dom": "^20.0.11",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.14",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.5",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.8",
    "storybook": "^10.3.6",
    "@storybook/react-vite": "^10.5.6",
    "@chromatic-com/storybook": "^5.1.2",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-onboarding": "^10.5.3",
    "eslint-plugin-storybook": "^10.4.6",
    "playwright": "^1.59.1",
    "@vitest/browser": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
